  "version": "0.0.1",
  "configurations": [
    {
      "name": "small-gpt",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "web.server"],
      "port": 8000
    },
    {
      "name": "small-gpt-essays",
      "runtimeExecutable": "python",
